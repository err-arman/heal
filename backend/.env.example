NODE_ENV=development
PORT=3000
APP_NAME=HEAL API
APP_VERSION=0.0.1
SWAGGER_ENABLED=true

# PostgreSQL connection string (node-postgres / Drizzle)
DATABASE_URL=postgresql://heal:heal@127.0.0.1:5432/heal
DB_SSL=false

# Local file storage (binaries never stored in PostgreSQL)
STORAGE_DIR=./storage
MAX_FILE_SIZE=104857600
